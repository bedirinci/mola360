# mola360 backend — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın. .env ASLA depoya girmez (.gitignore).

NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://mola360:mola360@127.0.0.1:5432/mola360

# Üretimde en az 32 karakter, rastgele üretin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=gelistirme-icin-yeterince-uzun-sir
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

ADMIN_ORIGIN=http://localhost:4000
SITE_ORIGIN=http://localhost:8000
PUBLIC_BASE_URL=https://bedirinci.github.io/mola360

LOG_LEVEL=info
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
HOLD_MINUTES=10
