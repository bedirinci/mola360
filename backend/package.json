{
  "name": "mola360-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "mola360 yönetim sistemi: API, veritabanı ve iş mantığı.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "seed": "node scripts/seed.js",
    "import:legacy": "node scripts/import-legacy.js",
    "reset": "node scripts/migrate.js reset && node scripts/seed.js && node scripts/import-legacy.js",
    "test": "vitest run"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  }
}
